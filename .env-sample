# Copy to .env and fill in real values before running aio app run / aio app deploy

# Adobe I/O Runtime namespace + auth (set automatically by `aio app use`)
# AIO_RUNTIME_NAMESPACE=
# AIO_RUNTIME_AUTH=

# Log level for actions (optional)
# LOG_LEVEL=debug

# Note: this app has no external secrets — the Files SDK uses your
# Runtime credentials automatically when running via `aio app run`/`deploy`.
